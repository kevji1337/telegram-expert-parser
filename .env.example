# Скопируй в .env и впиши свои значения

# === Автосвап аккаунтов при FloodWait ===
# Список аккаунтов через запятую (парсер переключается автоматически при бане)
TG_ACCOUNTS=account1,account2,account3

# Аккаунт 1
TG_API_ID_account1=12345678
TG_API_HASH_account1=abcdef0123456789abcdef0123456789

# Аккаунт 2
TG_API_ID_account2=87654321
TG_API_HASH_account2=fedcba9876543210fedcba9876543210

# Аккаунт 3
TG_API_ID_account3=11223344
TG_API_HASH_account3=aabbccdd11223344aabbccdd11223344

# TGStat (https://api.tgstat.ru) — нужен только для tg_channels_parser.py
TGSTAT_TOKEN=your_tgstat_token_here
